//
// COMFAST CF-WA350 — نسخة DSA (qca8k)
// النمط مبني على PR #24999 (MikroTik RB2011 DSA conversion by neheb)
// مع استخراج خصائص SGMII الدقيقة من initvals الأصلية:
//   0x04 0x00080080 = BIT(7) SGMII_EN + BIT(19) SGMII_RXCLK_FALLING_EDGE

#include "qca956x.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
    model = "COMFAST CF-WA350";
    compatible = "comfast,cf-wa350", "qca,qca9563";

    aliases {
        label-mac-device = &eth0;
        led-boot = &led_lan;
        led-failsafe = &led_lan;
        led-running = &led_lan;
        led-upgrade = &led_lan;
    };

    leds {
        compatible = "gpio-leds";

        led_lan: lan {
            color = <LED_COLOR_ID_GREEN>;
            function = LED_FUNCTION_LAN;
            gpios = <&gpio 17 GPIO_ACTIVE_HIGH>;
        };

        wan {
            color = <LED_COLOR_ID_RED>;
            function = LED_FUNCTION_WAN;
            gpios = <&gpio 15 GPIO_ACTIVE_HIGH>;
        };

        wlan5g {
            color = <LED_COLOR_ID_BLUE>;
            function = LED_FUNCTION_WLAN_5GHZ;
            gpios = <&gpio 16 GPIO_ACTIVE_HIGH>;
        };

        ext_wan {
            color = <LED_COLOR_ID_BLUE>;
            function = "ext-wan";
            gpios = <&gpio 7 GPIO_ACTIVE_LOW>;
        };

        ext_wlan2g {
            color = <LED_COLOR_ID_BLUE>;
            function = "ext-wlan2g";
            gpios = <&gpio 8 GPIO_ACTIVE_LOW>;
        };

        ext_lan {
            color = <LED_COLOR_ID_BLUE>;
            function = "ext-lan";
            gpios = <&gpio 21 GPIO_ACTIVE_LOW>;
        };
    };

    keys {
        compatible = "gpio-keys";

        reset {
            linux,code = <KEY_RESTART>;
            gpios = <&gpio 2 GPIO_ACTIVE_LOW>;
            debounce-interval = <60>;
        };
    };

    watchdog {
        compatible = "linux,wdt-gpio";
        gpios = <&gpio 6 GPIO_ACTIVE_HIGH>;
        hw_algo = "toggle";
        hw_margin_ms = <1000>;
        always-running;
    };
};

&pcie {
    status = "okay";

    wifi@0,0 {
        compatible = "qcom,ath10k";
        reg = <0x0000 0 0 0 0>;
        nvmem-cells = <&precal_art_5000>, <&macaddr_art_0 2>;
        nvmem-cell-names = "pre-calibration", "mac-address";
    };
};

&spi {
    status = "okay";

    flash@0 {
        compatible = "jedec,spi-nor";
        reg = <0>;
        spi-max-frequency = <25000000>;

        partitions {
            compatible = "fixed-partitions";
            #address-cells = <1>;
            #size-cells = <1>;

            partition@0 {
                label = "u-boot";
                reg = <0x000000 0x040000>;
                read-only;
            };

            partition@40000 {
                label = "art";
                reg = <0x040000 0x010000>;
                read-only;

                nvmem-layout {
                    compatible = "fixed-layout";
                    #address-cells = <1>;
                    #size-cells = <1>;

                    macaddr_art_0: macaddr@0 {
                        compatible = "mac-base";
                        reg = <0x0 0x6>;
                        #nvmem-cell-cells = <1>;
                    };

                    cal_art_1000: calibration@1000 {
                        reg = <0x1000 0x440>;
                    };

                    precal_art_5000: pre-calibration@5000 {
                        reg = <0x5000 0x2f20>;
                    };
                };
            };

            partition@50000 {
                compatible = "denx,uimage";
                label = "firmware";
                reg = <0x050000 0xfa0000>;
            };

            partition@ff0000 {
                label = "art-backup";
                reg = <0xff0000 0x010000>;
                read-only;
            };
        };
    };
};

//=============================================================================
// DSA: السويتش QCA8337 (المعروف لـ ar8216 باسم AR8337 rev 2)
// PHY ID = 0x004dd036 = QCA8337 في سائق qca8k
// المنفذ 0 = CPU عبر SGMII ، المنفذ 1 = فتحة WAN ، المنفذ 2 = فتحة LAN
//=============================================================================
&mdio0 {
    status = "okay";

    ethernet-switch@10 {
        compatible = "qca,qca8337";
        reg = <0>;

        mdio {
            #address-cells = <1>;
            #size-cells = <0>;

            internal_phy_port1: ethernet-phy@0 {
                reg = <0>;
            };

            internal_phy_port2: ethernet-phy@1 {
                reg = <1>;
            };
        };

        ethernet-ports {
            #address-cells = <1>;
            #size-cells = <0>;

            ethernet-port@0 {
                reg = <0>;
                label = "cpu";
                ethernet = <&eth0>;
                phy-mode = "sgmii";

                /* QCA8337 rev 2 مع SGMII: موصى به رسمياً في الوثائق */
                qca,sgmii-enable-pll;
                /* مستخرج من initvals الأصلية: 0x04 0x00080080 → BIT(19) */
                qca,sgmii-rxclk-falling-edge;

                fixed-link {
                    speed = <1000>;
                    full-duplex;
                };
            };

            ethernet-port@1 {
                reg = <1>;
                label = "wan";
                phy-handle = <&internal_phy_port1>;
            };

            ethernet-port@2 {
                reg = <2>;
                label = "lan";
                phy-handle = <&internal_phy_port2>;
            };
        };
    };
};

&wdt {
    status = "disabled";
};

&eth0 {
    status = "okay";

    pll-data = <0x03000101 0x00000101 0x00001919>;

    phy-mode = "sgmii";
    nvmem-cells = <&macaddr_art_0 0>;
    nvmem-cell-names = "mac-address";

    /* DSA master: وصلة ثابتة نحو منفذ CPU في السويتش (بدون phy-handle) */
    fixed-link {
        speed = <1000>;
        full-duplex;
    };
};

&wmac {
    status = "okay";

    nvmem-cells = <&macaddr_art_0 10>, <&cal_art_1000>;
    nvmem-cell-names = "mac-address", "calibration";
};
